import java.util.*;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int q = sc.nextInt();

        int[] arr = new int[n];

        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }

        while(q-- >0){

            int lt=sc.nextInt()-1;
            int rt=sc.nextInt()-1;

            int min=arr[lt];

            for(int i=lt;i<=rt;i++){
                min=Math.min(min,arr[i]);
            }

            System.out.println(min);
        }
    }
}
